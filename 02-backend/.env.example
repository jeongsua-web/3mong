DB_USER=fluento
DB_PASSWORD=your_strong_password_here

# 자체 JWT 서명 시크릿 (HMAC-SHA256, 최소 32바이트)
APP_JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes

# Google 로그인 OAuth 클라이언트 ID (프론트 GSI와 동일 값)
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>

# OpenAI API — https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# 운영은 비워두면 default 프로필 (JWT 인증 활성화)
# SPRING_PROFILES_ACTIVE=dev
